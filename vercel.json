{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
